# Copy this file to .env.local and fill in your values

# Supabase — https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key — NEVER expose to client, only use in server/edge functions
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Gemini AI — SERVER-ONLY (used by api/gemini.ts Vercel function, never sent to client)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Resend Email — https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
# Sender address (onboarding@resend.dev for testing, custom domain for production)
EMAIL_FROM=PromptVerse <onboarding@resend.dev>
# Public app URL used in email links
APP_URL=https://your-domain.vercel.app

# Sentry — https://sentry.io
VITE_SENTRY_DSN=your_sentry_dsn_here

# PostHog Analytics — https://posthog.com
VITE_POSTHOG_KEY=your_posthog_key_here
